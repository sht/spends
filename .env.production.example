# Copy to .env.production on the home server, then fill in your actual values.
SPENDS_IMAGE=YOUR_DOCKERHUB_USER/spends-tracker:YOUR_RELEASE_TAG
# Must already exist. For upgrades, use the same directory that currently holds your database and uploads.
SPENDS_DATA_DIR=/absolute/path/to/your/existing/spends-data
SPENDS_PORT=3031
TZ=Europe/Berlin
