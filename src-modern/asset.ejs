<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Asset details - Spends Tracker">
    <meta name="theme-color" content="#0d6efd">
    <title>Asset Viewer - Spends Tracker</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/public-assets/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/public-assets/favicon-16x16.png">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        .asset-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        .asset-card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            margin-bottom: 1.5rem;
        }
        .asset-header {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            color: white;
            border-radius: 0.5rem 0.5rem 0 0 !important;
        }
        .loading-screen {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        [x-cloak] {
            display: none !important;
        }
    </style>
</head>
<body>
    <!-- Loading Screen -->
    <div id="loading-screen" class="loading-screen" x-show="loading" x-cloak>
        <div class="text-center">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading asset details...</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="asset-container" x-data="assetViewer()" x-show="!loading" x-cloak>
        <!-- Error State -->
        <div x-show="error" class="text-center py-5">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
            <h2 class="mt-3 text-danger">Asset Not Found</h2>
            <p class="text-muted">This asset may have been deleted or the link is invalid.</p>
            <a href="/" class="btn btn-primary mt-3">
                <i class="bi bi-house me-2"></i>Go to Dashboard
            </a>
        </div>

        <!-- Asset Details -->
        <div x-show="!error && asset">
            <!-- Header Card -->
            <div class="card asset-card asset-header">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h1 class="h3 mb-1" x-text="asset?.product_name || 'Unknown Product'"></h1>
                            <p class="mb-0 opacity-75" x-text="formatCurrency(asset?.price, asset?.currency_code)"></p>
                        </div>
                        <span class="badge bg-light text-dark fs-6" x-show="asset?.quantity > 1" x-text="'Qty: ' + asset.quantity"></span>
                    </div>
                </div>
            </div>

            <!-- Details Grid -->
            <div class="card asset-card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Product Details</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6" x-show="asset?.retailer?.name">
                            <label class="text-muted small">Retailer</label>
                            <div class="fw-medium" x-text="asset?.retailer?.name"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.brand?.name">
                            <label class="text-muted small">Brand</label>
                            <div class="fw-medium" x-text="asset?.brand?.name"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.model_number">
                            <label class="text-muted small">Model Number</label>
                            <div class="fw-medium" x-text="asset?.model_number"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.serial_number">
                            <label class="text-muted small">Serial Number</label>
                            <div class="fw-medium" x-text="asset?.serial_number"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.retailer_order_number">
                            <label class="text-muted small">Order Number</label>
                            <div class="fw-medium" x-text="asset?.retailer_order_number"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.purchase_date">
                            <label class="text-muted small">Purchase Date</label>
                            <div class="fw-medium" x-text="formatDate(asset?.purchase_date)"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.link">
                            <label class="text-muted small">Product Link</label>
                            <div>
                                <a :href="asset?.link" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>View Product
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6" x-show="asset?.tax_deductible">
                            <label class="text-muted small">Tax Status</label>
                            <div><span class="badge bg-success">Tax Deductible</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Warranty Info -->
            <div class="card asset-card" x-show="asset?.warranty || asset?.warranty_expiry">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>Warranty Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6" x-show="asset?.warranty?.warranty_start">
                            <label class="text-muted small">Warranty Start</label>
                            <div class="fw-medium" x-text="formatDate(asset?.warranty?.warranty_start)"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.warranty?.warranty_end || asset?.warranty_expiry">
                            <label class="text-muted small">Warranty End</label>
                            <div class="fw-medium" x-text="formatDate(asset?.warranty?.warranty_end || asset?.warranty_expiry)"></div>
                        </div>
                        <div class="col-md-6" x-show="asset?.warranty?.status">
                            <label class="text-muted small">Status</label>
                            <div>
                                <span class="badge" :class="getWarrantyStatusBadge(asset?.warranty?.status)" x-text="asset?.warranty?.status || 'Unknown'"></span>
                            </div>
                        </div>
                        <div class="col-md-6" x-show="asset?.warranty?.provider">
                            <label class="text-muted small">Provider</label>
                            <div class="fw-medium" x-text="asset?.warranty?.provider"></div>
                        </div>
                        <div class="col-12" x-show="asset?.warranty?.notes">
                            <label class="text-muted small">Notes</label>
                            <div class="fw-medium" x-text="asset?.warranty?.notes"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Return Policy -->
            <div class="card asset-card" x-show="asset?.return_policy || asset?.return_deadline">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Return Policy</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6" x-show="asset?.return_deadline">
                            <label class="text-muted small">Return Deadline</label>
                            <div class="fw-medium" x-text="formatDate(asset?.return_deadline)"></div>
                        </div>
                        <div class="col-12" x-show="asset?.return_policy">
                            <label class="text-muted small">Policy Details</label>
                            <div class="fw-medium" x-text="asset?.return_policy"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notes -->
            <div class="card asset-card" x-show="asset?.notes">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Notes</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0" x-text="asset?.notes"></p>
                </div>
            </div>

            <!-- Tags -->
            <div class="card asset-card" x-show="asset?.tags">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Tags</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <template x-for="tag in (asset?.tags || '').split(',')" :key="tag">
                            <span class="badge bg-secondary" x-text="tag.trim()" x-show="tag.trim()"></span>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Share Link -->
            <div class="card asset-card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-share me-2"></i>Share This Asset</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Copy this link to share the asset with others:</p>
                    <div class="input-group">
                        <input type="text" class="form-control" :value="shareLink" readonly @click="selectShareLink">
                        <button class="btn btn-outline-primary" type="button" @click="copyShareLink">
                            <i class="bi bi-clipboard me-1"></i>Copy Link
                        </button>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center text-muted small">
                <p class="mb-1">Asset ID: <span x-text="assetId"></span></p>
                <p class="mb-0">Last updated: <span x-text="formatDate(asset?.updated_at)"></span></p>
            </div>
        </div>
    </div>

    <!-- Alpine.js -->
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.4/dist/cdn.min.js" defer></script>

    <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('assetViewer', () => ({
        asset: null,
        assetId: null,
        loading: true,
        error: false,
        shareLink: '',

        async init() {
          // Get asset ID from URL path (works for both /asset/{id} and /asset.html?id={id})
          const pathParts = window.location.pathname.split('/');
          const assetIndex = pathParts.indexOf('asset');
          
          if (assetIndex !== -1 && pathParts[assetIndex + 1]) {
            // Path format: /asset/{id}
            this.assetId = pathParts[assetIndex + 1];
          } else {
            // Query format: /asset.html?id={id}
            const urlParams = new URLSearchParams(window.location.search);
            this.assetId = urlParams.get('id');
          }

          if (!this.assetId) {
            this.loading = false;
            this.error = true;
            return;
          }

          this.shareLink = window.location.href;

          try {
            const response = await fetch('/api/public/asset/' + this.assetId);
            if (!response.ok) {
              if (response.status === 404) {
                this.error = true;
              } else {
                throw new Error('Failed to load asset');
              }
            } else {
              this.asset = await response.json();
            }
          } catch (error) {
            console.error('Error loading asset:', error);
            this.error = true;
          } finally {
            this.loading = false;
          }
        },

        formatCurrency(value, currency) {
          if (!value) return '';
          const numValue = parseFloat(value);
          if (isNaN(numValue)) return value;

          const currencySymbols = {
            'USD': '$',
            'EUR': '€',
            'GBP': '£',
            'JPY': '¥',
            'INR': '₹'
          };

          const symbol = currencySymbols[currency] || (currency + ' ');
          return symbol + numValue.toFixed(2);
        },

        formatDate(dateStr) {
          if (!dateStr) return '';
          try {
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            });
          } catch {
            return dateStr;
          }
        },

        getWarrantyStatusBadge(status) {
          const badges = {
            'ACTIVE': 'bg-success',
            'EXPIRED': 'bg-danger',
            'VOIDED': 'bg-secondary',
            'LIMITED': 'bg-warning text-dark',
            'EXTENDED': 'bg-info text-dark',
            'LIFETIME': 'bg-primary'
          };
          return badges[status] || 'bg-secondary';
        },

        selectShareLink(event) {
          event.target.select();
        },

        async copyShareLink() {
          try {
            await navigator.clipboard.writeText(this.shareLink);
            const btn = event.target.closest('button');
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check me-1"></i>Copied!';
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-success');
            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('btn-success');
              btn.classList.add('btn-outline-primary');
            }, 2000);
          } catch (error) {
            console.error('Failed to copy link:', error);
          }
        }
      }));
    });
    </script>
</body>
</html>
