# Backend Environment Variables
# Copy to .env and customize

# Backend server port
PORT=3031

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3030

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./spends_tracker.db

# Docker Compose only: host folder mounted as /app/data (database, uploads, backups)
SPENDS_DATA_DIR=/path/to/spends-data
